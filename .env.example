# Copy to `.env` for local examples and opt-in live tests.
# Never commit a real `.env` file.

# --- Credentials (pick one) ---
# Mollie API key (testmode keys start with test_, live with live_)
MOLLIE_API_KEY=
# Or organization OAuth access token
# MOLLIE_OAUTH_ACCESS_TOKEN=
# Optional OAuth client credentials for token endpoints
# MOLLIE_OAUTH_CLIENT_ID=
# MOLLIE_OAUTH_CLIENT_SECRET=

# Optional API base URL override (default: https://api.mollie.com)
# MOLLIE_BASE_URL=https://api.mollie.com

# Sticky testmode query for OAuth org tokens that need test entities
MOLLIE_TESTMODE=true

# Used by dotenv unit tests only
MOLLIE_DOTENV_TEST_MARKER=

# --- Route-example fixtures (safe placeholders) ---
# CLI flags with the matching kebab-case name take precedence when both are set.
BILLING_COUNTRY=NL
AMOUNT='{"currency":"EUR","value":"10.00"}'
BALANCE_ID=bal_1234567890
CAPTURE_ID=cpt_1234567890
CHARGEBACK_ID=chb_1234567890
CUSTOMER_ID=cst_1234567890
SUBSCRIPTION_ID=sub_1234567890
PAYMENT_ID=tr_1234567890
PAYMENT_LINK_ID=pl_1234567890
# OAuth-only for most list query filters: with MOLLIE_API_KEY, Mollie rejects
# profileId ("must not be sent"). Use a real pfl_* id only with OAuth tokens.
PROFILE_ID=
MANDATE_ID=mdt_1234567890
REFUND_ID=re_1234567890
SETTLEMENT_ID=stl_1234567890
TERMINAL_ID=term_1234567890
PERMISSION_ID=payments.read
ID=example-id
CURRENCY=EUR
EMBED=payments
EVENT_TYPES=payment-link.paid
FROM=
GROUPING=status-balances
INCLUDE=payments
INCLUDE_WALLETS=applepay
INVOICE_MONTH=01
LIMIT=50
LOCALE=en_US
METHOD_ID=ideal
MONTH=2026-01
ORDER_LINE_CATEGORIES=eco
REFERENCE=INV-12345
RESOURCE=payments
SEQUENCE_TYPE=oneoff
SORT=desc
UNTIL=2026-01-01
YEAR=2026

# Optional JSON replacement for generated request bodies.
# EXAMPLE_BODY_JSON={"amount":{"currency":"EUR","value":"10.00"}}
# EXAMPLE_BODY_FILE=./fixtures/request.json

# --- Opt-in live suites (never enabled in default CI) ---
# MOLLIE_LIVE_READONLY=1
# MOLLIE_TESTMODE_WRITE=1
